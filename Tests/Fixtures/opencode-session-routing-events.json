[
  {
    "name": "root lifecycle",
    "steps": [
      {
        "handler": "event",
        "input": {
          "type": "session.created",
          "properties": {
            "info": {
              "id": "root-session"
            }
          }
        }
      }
    ],
    "expected": [
      {
        "hook_event_name": "SessionStart",
        "session_id": "root-session"
      }
    ]
  },
  {
    "name": "child lifecycle",
    "steps": [
      {
        "handler": "event",
        "input": {
          "type": "session.created",
          "properties": {
            "info": {
              "id": "child-session",
              "parentID": "root-session"
            }
          }
        }
      },
      {
        "handler": "event",
        "input": {
          "type": "session.idle",
          "properties": {
            "info": {
              "id": "child-session"
            }
          }
        }
      }
    ],
    "expected": []
  },
  {
    "name": "unknown lifecycle",
    "steps": [
      {
        "handler": "event",
        "input": {
          "type": "session.idle",
          "properties": {
            "info": {
              "id": "unknown-session"
            }
          }
        }
      }
    ],
    "expected": []
  },
  {
    "name": "missing ID lifecycle",
    "steps": [
      {
        "handler": "event",
        "input": {
          "type": "session.error",
          "properties": {}
        }
      }
    ],
    "expected": []
  },
  {
    "name": "child lifecycle after root tracking reset",
    "steps": [
      {
        "handler": "event",
        "input": {
          "type": "session.created",
          "properties": {
            "info": {
              "id": "child-session",
              "parentID": "root-session"
            }
          }
        }
      },
      {
        "repeatRootSessionCreated": 512
      },
      {
        "handler": "chat.message",
        "input": {
          "sessionID": "child-session"
        }
      },
      {
        "handler": "event",
        "input": {
          "type": "session.idle",
          "properties": {
            "info": {
              "id": "child-session"
            }
          }
        }
      }
    ],
    "expected": [
      {
        "hook_event_name": "UserPromptSubmit",
        "session_id": "child-session"
      }
    ]
  }
]
