const AWESOMUX_PROTOCOL = "awesomux-agent-v1"

const sessionHookNames = {
    "session.created": "SessionStart",
    "session.idle": "Stop",
    "session.error": "StopFailure",
}

async function emitAwesoMuxHook($, hookEventName, sessionID) {
    if (!hookEventName || typeof $ !== "function") {
        return
    }
    if (process.env.AWESOMUX_AGENT_EVENT_PROTOCOL !== AWESOMUX_PROTOCOL) {
        return
    }
    if (!process.env.AWESOMUX_AGENT_EVENT_FILE) {
        return
    }

    const hook = process.env.AWESOMUX_AGENT_HOOK || "awesoMuxAgentHook"
    const payload = JSON.stringify({
        hook_event_name: hookEventName,
        ...(typeof sessionID === "string" ? { session_id: sessionID } : {}),
    })

    try {
        // Bun's `$` runs commands directly (no shell), so `hook` is one literal
        // argv token even if its path contains spaces, and `payload` arrives on
        // stdin rather than argv.
        await $`${hook} --provider opencode < ${new Response(payload)}`.quiet()
    } catch {
        // Swallow errors so a missing helper or non-awesoMux host never breaks
        // the OpenCode workflow.
    }
}

export const AwesoMuxOpenCodeStatus = async ({ $ }) => {
    const rootSessionIDs = new Set()
    // Cap-then-track: this set identifies ACTIVE root sessions, and an
    // unbounded map of dead ids would leak a few bytes per stale entry over a
    // long plugin-process lifetime. Clearing at the cap drops late events for
    // sessions that started before it (fail silent, never misattributing),
    // and 512 concurrent root sessions is far past any real process lifetime.
    const trackRootSession = (sessionID) => {
        if (rootSessionIDs.size >= 512) {
            rootSessionIDs.clear()
        }
        rootSessionIDs.add(sessionID)
    }

    return {
        event: async ({ event }) => {
            const info = event?.properties?.info
            if (event?.type === "session.created") {
                if (info?.parentID || typeof info?.id !== "string") {
                    return
                }
                trackRootSession(info.id)
            }
            const sessionID = info?.id || event?.properties?.sessionID
            if (typeof sessionID === "string" && !rootSessionIDs.has(sessionID)) {
                return
            }
            await emitAwesoMuxHook($, sessionHookNames[event?.type], sessionID)
        },
        "chat.message": async ({ sessionID }) => {
            if (typeof sessionID === "string") {
                trackRootSession(sessionID)
            }
            await emitAwesoMuxHook($, "UserPromptSubmit", sessionID)
        },
        "permission.ask": async () => {
            await emitAwesoMuxHook($, "PermissionRequest")
        },
        "tool.execute.before": async () => {
            await emitAwesoMuxHook($, "PreToolUse")
        },
        "tool.execute.after": async () => {
            await emitAwesoMuxHook($, "PostToolUse")
        },
    }
}
