const AWESOMUX_PROTOCOL = "awesomux-agent-v1"

const sessionHookNames = {
    "session.created": "SessionStart",
    "session.idle": "Stop",
    "session.error": "StopFailure",
}

async function emitAwesoMuxHook($, hookEventName, sessionID) {
    if (!hookEventName || typeof $ !== "function") {
        return
    }
    if (process.env.AWESOMUX_AGENT_EVENT_PROTOCOL !== AWESOMUX_PROTOCOL) {
        return
    }
    if (!process.env.AWESOMUX_AGENT_EVENT_FILE) {
        return
    }

    const hook = process.env.AWESOMUX_AGENT_HOOK || "awesoMuxAgentHook"
    const payload = JSON.stringify({
        hook_event_name: hookEventName,
        ...(typeof sessionID === "string" ? { session_id: sessionID } : {}),
    })

    try {
        // Bun's `$` runs commands directly (no shell), so `hook` is one literal
        // argv token even if its path contains spaces, and `payload` arrives on
        // stdin rather than argv.
        await $`${hook} --provider opencode < ${new Response(payload)}`.quiet()
    } catch {
        // Swallow errors so a missing helper or non-awesoMux host never breaks
        // the OpenCode workflow.
    }
}

export const AwesoMuxOpenCodeStatus = async ({ $ }) => {
    const rootSessionIDs = new Set()
    const childSessionIDs = new Set()
    // Cap-then-track: these sets identify ACTIVE root vs child sessions, and
    // an unbounded map of dead ids would leak a few bytes per stale entry over
    // a long plugin-process lifetime. Clearing at the cap drops late events
    // for sessions that started before it (fail silent, never misattributing),
    // and 512 concurrent root sessions is far past any real process lifetime.
    // A cleared child set can re-promote an old child via chat.message until
    // its next session.created replays — the same fail-silent posture.
    const trackInto = (set, sessionID) => {
        if (set.size >= 512) {
            set.clear()
        }
        set.add(sessionID)
    }

    return {
        event: async ({ event }) => {
            const info = event?.properties?.info
            if (event?.type === "session.created") {
                if (typeof info?.id !== "string") {
                    return
                }
                if (info.parentID) {
                    trackInto(childSessionIDs, info.id)
                    return
                }
                trackInto(rootSessionIDs, info.id)
            }
            const sessionID = info?.id || event?.properties?.sessionID
            // Fail closed: lifecycle events (Stop → awesoMux "waiting",
            // StopFailure → "error") must only fire for the ROOT session this
            // pane hosts. OpenCode also idles/errors CHILD sessions (task
            // subagents) mid-parent-turn; emitting those painted a false
            // waiting prompt while the agent was still running. An unknown or
            // missing id drops the event rather than leaking it.
            if (!rootSessionIDs.has(sessionID)) {
                return
            }
            await emitAwesoMuxHook($, sessionHookNames[event?.type], sessionID)
        },
        "chat.message": async ({ sessionID }) => {
            // Subagent turns flow through this hook with their own session id;
            // promoting them would let their later session.idle pass the root
            // filter above as a false parent turn-end. Only sessions never
            // announced as children may seed the root set (covers sessions
            // created before this plugin attached).
            if (typeof sessionID === "string" && !childSessionIDs.has(sessionID)) {
                trackInto(rootSessionIDs, sessionID)
            }
            await emitAwesoMuxHook($, "UserPromptSubmit", sessionID)
        },
        "permission.ask": async () => {
            await emitAwesoMuxHook($, "PermissionRequest")
        },
        "tool.execute.before": async () => {
            await emitAwesoMuxHook($, "PreToolUse")
        },
        "tool.execute.after": async () => {
            await emitAwesoMuxHook($, "PostToolUse")
        },
    }
}
